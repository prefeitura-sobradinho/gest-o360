rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leitura pública (painel é transparência ativa); escrita só para usuários autenticados.
    match /metas/{id}     { allow read: if true; allow write: if request.auth != null; }
    match /kpis/{id}      { allow read: if true; allow write: if request.auth != null; }
    match /destaques/{id} { allow read: if true; allow write: if request.auth != null; }
    match /portfolio/{id} { allow read: if true; allow write: if request.auth != null; }
    match /execucao/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /receitas/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /convenios/{id} { allow read: if true; allow write: if request.auth != null; }
    match /{document=**}  { allow read, write: if false; }
  }
}
